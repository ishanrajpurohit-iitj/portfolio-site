---
// Either a real navigation (href, case studies -> /work) or a same-page
// radio-toggle "back" (htmlFor, e.g. Writings' article view -> its own
// list — see writings.astro) — same chevron/positioning either way, this
// just picks <a href> vs <label for>, since a radio-toggle "back" has no
// URL to navigate to.
interface Props {
  href?: string;
  htmlFor?: string;
}

const { href, htmlFor } = Astro.props;
---

<div class="back-row">
  {htmlFor ? (
    <label class="back-btn" for={htmlFor} aria-label="Back">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M12.5 5L7.5 10L12.5 15" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </label>
  ) : (
    <a class="back-btn" href={href} aria-label="Back">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M12.5 5L7.5 10L12.5 15" stroke="#000" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  )}
</div>

<style>
  .back-row {
    position: relative;
    width: 100%;
    height: 72px;
    flex-shrink: 0;
    overflow: hidden;
    box-sizing: border-box;
  }

  .back-btn {
    position: absolute;
    left: 15px;
    top: 26px;
    width: 20px;
    height: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
</style>
