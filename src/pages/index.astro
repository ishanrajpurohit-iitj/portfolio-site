  /* No fill — the Figma file has none either (direct feedback: "why does
     the carousel have a solid fill?"). It sits directly on the page, same
     as every desktop desk item sitting straight on the desk scene with no
     boxed canvas behind it; .m-home-backdrop's own photo is what actually
     shows through here. */
  .m-hero-carousel-viewport {
    overflow: hidden;
    width: 100%;
    /* Lets the browser keep handling vertical page scroll natively while
       the JS pointer handlers below own horizontal movement — without this
       the first bit of every swipe fights the page's own scroll gesture. */
    touch-action: pan-y;
  }

  .m-hero-carousel-track {
    display: flex;
    /* Springy-but-settled easing matches the rest of this site's motion
       language (window open/minimize, MobileTitlebar's flip) rather than a
       linear or purely-decelerating curve, so a chevron tap reads as part
       of the same interaction vocabulary as everything else here. */
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* No horizontal padding — Figma positions Mac at exactly 42px in from
     each edge of the 350px carousel (42 + 266 + 42 = 350, i.e. genuinely
     centered), not inset by a separately-invented clearance margin. The
     64px padding this replaced was sized for the OLD 58%/92%-based image
     sizing; once the image got a real fixed 266px width (see below), that
     padding left only 222px of content box for a 266px image, so the
     browser silently let it overflow the padding box — explaining the
     "not horizontally centered" bug this fixes (the overflow wasn't
     symmetric, so centering looked broken even though justify-content was
     correct). Chevron clearance still holds at 42px either side, just not
     via padding. */
  .m-hero-slide {
    flex: 0 0 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 300px;
    box-sizing: border-box;
    padding: 24px 0;
  }

  .m-hero-slide img {
    /* Fixed 266x213 — Figma's own exact Mac image size (node 2397:10632,
       "Mac image": w=266 h=213), not a percentage of the slide box. A
       percentage (92%, before that 58%) never actually matched the
       designer's real target size; this does, verbatim, and still can't
       reach the chevrons on either side (same clearance guarantee the
       padding above already provides, just no longer computed relative to
       a percentage that could drift). */
    max-width: 266px;
    max-height: 213px;
    object-fit: contain;
    /* Same drop-shadow every desktop desk item uses (home.css) — a plain
       box-shadow would trace the image's rectangular bounding box, not the
       actual transparent-cutout illustration, and read as a visible box
       floating behind it (see MEMORY.md's box-shadow-vs-drop-shadow note). */
    filter: drop-shadow(0px 4px 10px rgba(0, 0, 0, 0.22));
  }

