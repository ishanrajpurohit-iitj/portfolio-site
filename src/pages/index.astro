  /* No more :disabled boundary state — the carousel loops now (direct
     instruction: "the caoursel should be infinite last ke baad first"),
     via cloned lead/trail slides in the track (see initHeroCarousel) that
     make wrapping just one more single-step slide instead of a whole-track
     whip-pan back to the start, so there's no longer a "you're at the end"
     boundary to communicate — both chevrons stay live always. */

</style>

<script>
  // Types out the hero headline a character at a time, with a blinking
  // cursor that stops and fades once it's done. Reads the real text straight
  // off the element on its FIRST run only, cached in data-full-text — once
  // typing starts, el.textContent is no longer the true full string (it's
  // whatever's been typed so far), so a later run has to reuse the cached
  // copy rather than re-reading the element. Re-runs on every
  // astro:page-load rather than once-ever — unlike the dock's persisted
  // entrance, Home's own content is freshly rendered on every arrival here
  // (nothing about it persists across navigations), so replaying it each
  // time you land on Home is the natural default, not a bug to guard
  // against. That said, astro:page-load fires an extra time right after the
  // very first load's own top-level call below (same double-invocation
  // astro's own lifecycle produces for any script that both runs at parse
  // time and listens for astro:page-load — see AppLayout's dock-entrance
  // script for the same pattern) — data-type-run is a per-element counter
  // so a still-running older loop can tell it's been superseded and quietly
  // stop instead of racing a newer one to write the same element.
  function typewriteHeadline() {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.hero-headline p, .m-hero h1').forEach((el) => {
      if (!(el instanceof HTMLElement)) return;
      if (el.dataset.fullText === undefined) el.dataset.fullText = el.textContent ?? '';
      const fullText = el.dataset.fullText;
      const runId = String(Number(el.dataset.typeRun || '0') + 1);
      el.dataset.typeRun = runId;
      el.textContent = '';
      el.classList.remove('typewriter-done');
      el.classList.add('typewriter-active');
      let i = 0;
      const typeNext = () => {
        if (el.dataset.typeRun !== runId) return;
        el.textContent = fullText.slice(0, i);
        const justTyped = fullText[i - 1];
        i++;
        if (i <= fullText.length) {
          // A real typewriter's rhythm isn't perfectly even — a longer beat
          // right after a comma reads as a deliberate pause, not just a
          // uniform mechanical tick.
          const delay = justTyped === ',' ? 480 : 90;
          setTimeout(typeNext, delay);
        } else {
          el.classList.remove('typewriter-active');
          el.classList.add('typewriter-done');
        }
      };
      setTimeout(typeNext, 300);
    });
  }

  typewriteHeadline();
  document.addEventListener('astro:page-load', typewriteHeadline);

  // Mobile hero carousel (see the markup comment above for the Figma node
  // and the reasoning behind chevrons-browse/image-navigates). Re-binds and
  // resets on every astro:page-load, same as typewriteHeadline above — Home
  // is never persisted, so a fresh instance mounts every time you arrive
  // here.
  //
  // Two direct follow-ups from user testing ("people on mobile are unable
  // to figure out to tap carousel"):
  // 1. Auto-advance — the carousel now scrolls on its own so its very
  //    existence and interactivity is obvious without anyone finding the
  //    swipe/chevron affordance first.
  // 2. Infinite loop — "last ke baad first" (first after last), so
  //    auto-advance actually has somewhere to go forever instead of
  //    stalling dead at the last slide.
  //
  // Infinite looping is implemented with a cloned lead/trail slide at each
  // end of the track (the standard technique for this) rather than index
  // wrapping alone — index wrapping straight from last back to 0 with a
  // plain index*-100% transform would visually whip-pan backward across
  // every slide in one 0.4s transition instead of stepping by one. With
  // clones, advancing off the real last slide is a normal single-step
  // transition onto an identical-looking clone of the first slide; once
  // that transition lands, a transitionend listener silently snaps the
  // index back to the real first slide with transitions off for that one
  // frame — invisible, since the clone and the real slide are pixel-
  // identical. Same idea in the other direction for "previous" past the
  // first slide.
  function initHeroCarousel() {
    document.querySelectorAll('.m-hero-carousel').forEach((carousel) => {
      if (!(carousel instanceof HTMLElement) || carousel.dataset.bound === 'true') return;
      carousel.dataset.bound = 'true';

      const viewport = carousel.querySelector('.m-hero-carousel-viewport');
      const track = carousel.querySelector('.m-hero-carousel-track');
      const realSlides = Array.from(carousel.querySelectorAll('.m-hero-slide'));
      const prevBtn = carousel.querySelector('.m-hero-chevron-prev');
      const nextBtn = carousel.querySelector('.m-hero-chevron-next');
      if (!(track instanceof HTMLElement) || !(viewport instanceof HTMLElement) || realSlides.length === 0) return;

      // Clones are purely visual filler for the loop-around transition —
      // hidden from assistive tech and out of tab order so a screen reader
      // or keyboard user never lands on a duplicate "Play intro"/etc.
      function cloneSlide(original) {
        const clone = original.cloneNode(true);
        if (clone instanceof HTMLElement) {
          clone.setAttribute('aria-hidden', 'true');
          clone.tabIndex = -1;
        }
        return clone;
      }

      const leadClone = cloneSlide(realSlides[realSlides.length - 1]);
      const trailClone = cloneSlide(realSlides[0]);
      track.insertBefore(leadClone, realSlides[0]);
      track.appendChild(trailClone);

      const slides = Array.from(track.children); // [leadClone, ...real, trailClone]
      const firstRealIndex = 1;
      const lastRealIndex = slides.length - 2;
      let index = firstRealIndex;

      function render(animate) {
        track.style.transition = animate === false ? 'none' : '';
        track.style.transform = `translateX(${index * -100}%)`;
      }

      // Lands on a clone → jump to the real slide it's standing in for,
      // with no transition (both look identical, so the jump is invisible).
      // Called from BOTH a transitionend listener and a plain setTimeout
      // fallback in goTo below — found live, not hypothetical: transitionend
      // never fires at all for a transition happening inside a display:none
      // subtree (true here whenever the real viewport is wide enough that
      // .mobile-shell itself is display:none, which is still where this
      // script runs and keeps auto-advancing in the background), so relying
      // on it alone let index climb unboundedly past the clone position with
      // nothing ever wrapping it back — confirmed live via translateX
      // reaching -800%/-900%/-1000% and climbing, on a track with only 7
      // children (a valid range of 0% to -600%). The timer fires regardless
      // of visibility/display state, so it's what actually guarantees this
      // runs; the transitionend listener staying too just means the wrap
      // still happens at the natural moment (right as the transition
      // visually finishes) whenever it's available, rather than always
      // waiting out the fallback's fixed delay.
      function checkWrap() {
        if (index === 0) {
          index = lastRealIndex;
          render(false);
        } else if (index === slides.length - 1) {
          index = firstRealIndex;
          render(false);
        }
      }

      function goTo(next) {
        index = next;
        render(true);
        setTimeout(checkWrap, 450);
      }

      track.addEventListener('transitionend', (e) => {
        if (e.target !== track || e.propertyName !== 'transform') return;
        checkWrap();
      });

      prevBtn?.addEventListener('click', () => {
        stopAuto();
        goTo(index - 1);
        scheduleAuto();
      });
      nextBtn?.addEventListener('click', () => {
        stopAuto();
        goTo(index + 1);
        scheduleAuto();
      });

      // Swipe — direct instruction: "add swipe to the home carousel". Live
      // drag-follow (not just a swipe-direction sniff on touchend) so it
      // reads as a real touch surface rather than a gesture detector: the
      // track visually tracks the finger 1:1 during the drag, then either
      // commits to the neighboring slide or snaps back on release depending
      // on how far past the threshold the drag went. transition is switched
      // off for the live-follow (an animated .transform during pointermove
      // would lag a finger by a frame every update) and restored for the
      // commit/snap-back step, which is exactly where the existing
      // spring-settle easing (see .m-hero-carousel-track) belongs. No more
      // edge resistance — the loop means there's no longer a real edge to
      // resist against.
      let dragging = false;
      let dragStartX = 0;
      let dragDeltaX = 0;
      let dragMoved = false;
      let viewportWidth = 0;

      function onPointerDown(e) {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        stopAuto();
        dragging = true;
        dragMoved = false;
        dragDeltaX = 0;
        dragStartX = e.clientX;
        viewportWidth = viewport.getBoundingClientRect().width || 1;
        track.style.transition = 'none';
        // Defensive only — a pointerId setPointerCapture can't find (e.g. one
        // that never went through a real hit-test) throws rather than being a
        // silent no-op; swallowed so it can't abort the rest of the gesture.
        try {
          viewport.setPointerCapture(e.pointerId);
        } catch (err) {
          /* not capturable — drag still tracks fine via the window-level
             pointermove/pointerup listeners below */
        }
      }

      function onPointerMove(e) {
        if (!dragging) return;
        dragDeltaX = e.clientX - dragStartX;
        if (Math.abs(dragDeltaX) > 6) dragMoved = true;
        track.style.transform = `translateX(calc(${index * -100}% + ${dragDeltaX}px))`;
      }

      function endDrag(e) {
        if (!dragging) return;
        dragging = false;
        track.style.transition = '';
        const threshold = Math.max(40, viewportWidth * 0.12);
        if (dragDeltaX <= -threshold) {
          goTo(index + 1);
        } else if (dragDeltaX >= threshold) {
          goTo(index - 1);
        } else {
          render(true);
        }
        if (e && viewport.hasPointerCapture(e.pointerId)) viewport.releasePointerCapture(e.pointerId);
        dragDeltaX = 0;
        scheduleAuto();
      }

      viewport.addEventListener('pointerdown', onPointerDown);
      viewport.addEventListener('pointermove', onPointerMove);
      viewport.addEventListener('pointerup', endDrag);
      viewport.addEventListener('pointercancel', endDrag);

      // A real drag shouldn't also fire the slide's own <a href> navigation
      // underneath it — captured on the track (fires before the anchor's
      // own click) and only swallowed when this specific gesture actually
      // moved past the tap-vs-drag threshold above.
      track.addEventListener(
        'click',
        (e) => {
          if (dragMoved) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );

      // Auto-advance — direct instruction: "keep live carousel scrolling on
      // so people can see". Paused for the duration of any manual
      // interaction (drag start through drag end, or a chevron tap) and
      // rescheduled fresh afterward, rather than stopping for good the first
      // time someone touches it — the point is an always-eventually-moving
      // carousel, not just a one-time animated hint. Cleared on navigating
      // away so it isn't still ticking against a detached track once Home's
      // DOM is gone (Home is never transition:persist — a fresh interval
      // would otherwise leak on every single visit).
      let autoTimer = null;
      function stopAuto() {
        if (autoTimer) clearTimeout(autoTimer);
        autoTimer = null;
      }
      function scheduleAuto() {
        stopAuto();
        autoTimer = setTimeout(() => {
          goTo(index + 1);
          scheduleAuto();
        }, 3200);
      }
      document.addEventListener('astro:before-preparation', stopAuto, { once: true });

      render(false);
      scheduleAuto();
    });
  }

  initHeroCarousel();
  document.addEventListener('astro:page-load', initHeroCarousel);
</script>
