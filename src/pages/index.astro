<style>
  /* Desktop Home never uses Layout's shared .page-backdrop — the hero
     illustrations already *are* the desk, so a backdrop behind them would
     just be clutter. Mobile swaps that hero for a plain icon grid, so it
     needs its own backdrop image to keep the "sitting at the desk" feel;
     scoped to this component and only ever reachable via the mobile
     fragment (which is display:none entirely on desktop widths), so it
     can never show up in the desktop render. */
  .m-home-backdrop {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .m-home-backdrop img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  /* Centered, matching desktop's own hero (.hero-headline/.hero-subtext in
     home.css are both text-align:center) — direct feedback: this was left-
     aligned before, which was never asked for anywhere and didn't match
     desktop's composition. */
  /* Values now taken directly from Figma node 2397:10619 ("Mobile Home —
     Play (Mac)") — pt-48, gap-64 between the toggle and the hero+carousel
     group — rather than the guessed/rounded values an earlier "improve
     the spacing" pass used. safe-area-inset is still added on top of the
     flat 48px so a notch/status-bar doesn't eat into it, since Figma's own
     canvas has no such concept to account for. */
  .m-home {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 64px;
    padding: calc(48px + env(safe-area-inset-top, 0px)) 20px 20px;
  }

  /* Scaled-down version of Nav.astro's #mode-toggle (72x36 there) — see
     that component for the full switch styling this mirrors. A SEPARATE
     id/checkbox from desktop's, not a reuse — both the desktop and mobile
     trees render into the same document at once (Layout.astro's
     .mobile-shell), just one hidden via CSS depending on viewport width,
     so a single #mode-toggle id would collide. */
  .m-home-toggle {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .m-toggle-label {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 100;
    font-size: 14px;
    color: #000;
    cursor: pointer;
  }

  .m-toggle-switch {
    position: relative;
    width: 48px;
    height: 24px;
    flex-shrink: 0;
  }

  .m-toggle-checkbox {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    pointer-events: none;
  }

  .m-toggle-track {
    position: absolute;
    inset: 0;
    border-radius: 12px;
    background: #d6cab6;
    box-shadow: inset 0px 3px 1.5px 0px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .m-toggle-track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: linear-gradient(to bottom, #fefaf5, #ebe3d6);
    box-shadow: 0px 3px 2.5px 0px rgba(0, 0, 0, 0.18);
    transition: left 0.15s ease;
  }

  .m-toggle-switch:has(.m-toggle-checkbox:checked) .m-toggle-track {
    background: #4dbf5e;
  }

  .m-toggle-switch:has(.m-toggle-checkbox:checked) .m-toggle-track::after {
    left: 27px;
  }

  .m-home-panels {
    width: 100%;
  }

  /* gap 8px, not 32 — Figma positions the Carousel only ~3px below Hero's
     own bottom (Hero's rendered height plus its own internal gaps very
     nearly equals the Carousel's 191px offset from the shared area's top;
     see get_design_context on 2397:10619). 8px keeps a hair of breathing
     room for the browser's own font-metric rounding without reopening the
     32px gap this replaces, which read as far looser than the actual
     design. */
  .m-home-panel-play {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    animation: m-panel-fade-in 0.3s ease-out;
  }

  /* Mobile equivalent of desktop's .home-projects (the "View" panel) —
     hidden by default (Play is the default mode, matching desktop's own
     #mode-toggle checked-by-default). display:none/flex rather than
     desktop's absolute-position opacity crossfade — that approach exists
     on desktop specifically to keep .panel-stack's height constant so
     .scale-frame's shared scale factor doesn't shift between modes (see
     that comment in home.css); mobile has no shared frame-scale to
     protect, so a plain swap is simpler and there's nothing lost by it. */
  .m-home-panel-view {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 100%;
  }

  /* Scoped to .m-home, not .m-home-panels — the checkbox lives in
     .m-home-toggle, a SIBLING of .m-home-panels, not a descendant of it,
     so :has() has to reach from their shared ancestor instead (same shape
     as desktop's own .page-shell:has(#mode-toggle...) in home.css, for
     the identical reason: Nav and .panel-stack are siblings there too). */
  .m-home:has(.m-toggle-checkbox:not(:checked)) .m-home-panel-play {
    display: none;
  }

  .m-home:has(.m-toggle-checkbox:not(:checked)) .m-home-panel-view {
    display: flex;
    animation: m-panel-fade-in 0.3s ease-out;
  }

  /* View mode's résumé text sits directly on the page background (no card/
     panel behind it), so the desk-photo backdrop showing through was
     killing contrast — direct feedback: "remove the backdrop behind view
     mode, text nahi dikh raha". Play mode keeps the backdrop as before. */
  .m-home:has(.m-toggle-checkbox:not(:checked)) .m-home-backdrop {
    display: none;
  }

  @keyframes m-panel-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
