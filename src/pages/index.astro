        <img
          class="illustration-cover"
          src="/images/home/illustration-turntable.png"
          alt="Turntable record player"
        />
      </a>

      <a class="illustration-racket-wrap" data-figma-node="2:4" href="/hobbies" aria-label="Squash" data-transition-slow>
        <div class="illustration-racket-rotate">
          <div class="illustration-racket-frame">
            <img src="/images/home/illustration-racket.png" alt="Squash racket" />
          </div>
        </div>
