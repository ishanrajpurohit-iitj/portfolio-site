<!-- Section videos autoplay declaratively, but every panel except the
     default (Problem) starts display:none — a video inside a hidden
     ancestor fails its autoplay attempt silently and never resumes it once
     the panel becomes visible (browsers don't retroactively retry). So each
     tab switch explicitly calls .play() on that panel's own videos, the
     same fix already used for Writings' Captures tab. -->
<script>
  function playPanelVideos(panel: Element | null) {
    panel?.querySelectorAll('video').forEach((video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      // Same fix as Writings' Captures tab: a load attempted while this
      // panel was still display:none (every panel but Problem starts
      // hidden) can leave the element stuck in a failed resource-selection
      // state — play() alone never recovers from that, load() does.
      if (video.error || video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) {
        video.load();
      }
      if (video.paused) video.play().catch(() => {});
    });
  }

  function playCheckedPanel(radio: Element) {
    if (!(radio instanceof HTMLInputElement) || !radio.checked) return;
    const panelClass = 'panel-' + radio.id.replace('ph-', '');
    playPanelVideos(document.querySelector('.' + panelClass));
  }

  document.querySelectorAll('.cs-radio').forEach((radio) => {
    radio.addEventListener('change', () => playCheckedPanel(radio));
    playCheckedPanel(radio);
  });
</script>

<style>
  .cs-body {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cs-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cs-row {
    display: flex;
    flex: 1 0 0;
    gap: 40px;
    align-items: flex-start;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 0 64px 72px 0;
    width: 100%;
    box-sizing: border-box;
  }

  .cs-sidebar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding-top: 24px;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    width: 200px;
  }

  .cs-pill {
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 12px 0 12px 32px;
    border-radius: 0 60px 60px 0;
    filter: drop-shadow(0px 4px 5.25px rgba(0, 0, 0, 0.16));
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 20px;
    color: #000;
    white-space: nowrap;
    cursor: pointer;
  }

  #ph-problem:checked ~ .cs-row .cs-sidebar label[for='ph-problem'],
  #ph-bet:checked ~ .cs-row .cs-sidebar label[for='ph-bet'],
  #ph-assistant:checked ~ .cs-row .cs-sidebar label[for='ph-assistant'],
  #ph-control:checked ~ .cs-row .cs-sidebar label[for='ph-control'],
  #ph-constraint:checked ~ .cs-row .cs-sidebar label[for='ph-constraint'],
  #ph-result:checked ~ .cs-row .cs-sidebar label[for='ph-result'],
  #ph-visuals:checked ~ .cs-row .cs-sidebar label[for='ph-visuals'] {
    background: #ebe3d7;
    box-shadow: 0px 4px 10.5px 0px rgba(0, 0, 0, 0.16);
    filter: none;
  }

  .cs-content {
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    min-width: 0;
    padding: 24px 20px 0;
    box-sizing: border-box;
  }

  .cs-panel {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .cs-panel.centered {
    align-items: center;
  }

  @keyframes tab-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  #ph-problem:checked ~ .cs-row .panel-problem,
  #ph-bet:checked ~ .cs-row .panel-bet,
  #ph-assistant:checked ~ .cs-row .panel-assistant,
  #ph-control:checked ~ .cs-row .panel-control,
  #ph-constraint:checked ~ .cs-row .panel-constraint,
  #ph-result:checked ~ .cs-row .panel-result,
