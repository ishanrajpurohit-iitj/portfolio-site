<style>
  .cs-body {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .cs-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .cs-row {
    display: flex;
    flex: 1 0 0;
    gap: 40px;
    align-items: flex-start;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: none;
    padding: 0 64px 72px 0;
    width: 100%;
    box-sizing: border-box;
  }

  .cs-row::-webkit-scrollbar {
    display: none;
  }

  .cs-sidebar {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding-top: 24px;
    flex-shrink: 0;
    position: sticky;
    top: 0;
    width: 200px;
  }

  .cs-pill {
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 12px 0 12px 32px;
    border-radius: 0 60px 60px 0;
    filter: drop-shadow(0px 4px 5.25px rgba(0, 0, 0, 0.16));
    width: 100%;
    box-sizing: border-box;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 20px;
    color: #000;
    white-space: nowrap;
    cursor: pointer;
  }

  #cs-problem:checked ~ .cs-row .cs-sidebar label[for='cs-problem'],
  #cs-architecture:checked ~ .cs-row .cs-sidebar label[for='cs-architecture'],
  #cs-bottlenecks:checked ~ .cs-row .cs-sidebar label[for='cs-bottlenecks'],
  #cs-triage:checked ~ .cs-row .cs-sidebar label[for='cs-triage'],
  #cs-hardestuser:checked ~ .cs-row .cs-sidebar label[for='cs-hardestuser'],
  #cs-validation:checked ~ .cs-row .cs-sidebar label[for='cs-validation'],
  #cs-reflection:checked ~ .cs-row .cs-sidebar label[for='cs-reflection'] {
    background: #ebe3d7;
    box-shadow: 0px 4px 10.5px 0px rgba(0, 0, 0, 0.16);
    filter: none;
  }

  .cs-content {
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    min-width: 0;
    padding: 24px 20px 0;
    box-sizing: border-box;
  }

  .cs-panel {
    display: none;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
  }

  .cs-panel.centered {
    align-items: center;
  }

  @keyframes tab-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  #cs-problem:checked ~ .cs-row .panel-problem,
  #cs-architecture:checked ~ .cs-row .panel-architecture,
  #cs-bottlenecks:checked ~ .cs-row .panel-bottlenecks,
  #cs-triage:checked ~ .cs-row .panel-triage,
  #cs-hardestuser:checked ~ .cs-row .panel-hardestuser,
  #cs-validation:checked ~ .cs-row .panel-validation,
  #cs-reflection:checked ~ .cs-row .panel-reflection {
    display: flex;
    animation: tab-fade-in 0.3s ease-out;
  }

  /* Problem panel: overview header + problem row */
  .panel-problem {
    gap: 20px;
  }

  .overview-header {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
  }

  .overview-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 48px;
    line-height: normal;
    color: #000;
  }

  .meta-grid {
    display: flex;
    gap: 30px;
    align-items: flex-start;
    width: 100%;
  }

  .meta-col {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1 0 0;
    min-width: 0;
  }

  .meta-label {
    margin: 0;
    font-family: 'Geist Mono', var(--font-mono);
