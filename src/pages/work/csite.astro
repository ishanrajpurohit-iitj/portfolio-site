  .emphasis-line {
    font-family: 'Helvetica Neue', -apple-system, system-ui, sans-serif;
    font-weight: 400;
  }

  .phone-shot {
    position: relative;
    flex-shrink: 0;
    width: 177px;
    height: 384px;
    border: 2px solid #acacac;
    border-radius: 30px;
    box-shadow: 2px 4px 8.5px 0px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
    overflow: hidden;
    cursor: zoom-in;
  }

  .phone-shot img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    transition: transform 0.2s ease-out;
  }

  .phone-shot:hover img {
    transform: scale(1.04);
  }

  .phone-shot-thick {
    border-width: 4px;
  }

