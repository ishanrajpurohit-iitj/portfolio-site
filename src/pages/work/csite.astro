    font-size: 14px;
    color: #000;
  }

  .meta-value {
    margin: 0;
    font-family: 'Helvetica Neue', -apple-system, system-ui, sans-serif;
    font-size: 16px;
    line-height: 22px;
    color: #5b5a5a;
  }

  .overview-desc {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 16px;
    line-height: 22px;
    color: #8b8b8b;
  }

  .problem-row {
    display: flex;
    gap: 60px;
    align-items: flex-start;
    width: 100%;
  }

  .section-text {
    display: flex;
    flex-direction: column;
    gap: 30px;
    flex: 1 0 0;
    min-width: 0;
  }

