---
import AppLayout from '../layouts/AppLayout.astro';
import Window from '../components/Window.astro';
import MobileTitlebar from '../components/MobileTitlebar.astro';

// Case-study cards restyled to match the Other Work tile format (bigger
// cover, caption + tags below instead of an overlay bar on top of the
// image) — direct instruction: "replacing case studies cards with similar
// format." Still plain links to the full case-study pages though, not the
// click-to-open filmstrip viewer: these are full written case studies
// (research, IA, process), not a self-contained image/deck/reel, so they
// need their own page, not a quick-look overlay — confirmed with the user
// before building. ProjectCard.astro itself is untouched (still used by
// index.astro's Home "View" panel).
const caseStudies = [
  {
    image: '/images/work/card-csite.png',
    imageStyle: 'left:0.09%; top:-107.91%; width:100%; height:315.81%;',
    title: 'Digitizing construction-site management across three roles',
    description: "A mobile + web platform for India's unorganized construction sector. I was the only designer: research, information architecture, the design system, UI, and prototyping.",
    tags: ['Case Study', 'Product Design', 'B2B Systems'],
    href: '/work/csite',
  },
  {
    image: '/images/work/card-photoshop2030.png',
    video: '/images/work/photoshop2030/more-visuals-1-cover.mp4',
    title: 'Reimagining Photoshop as a 2030 AI editor you can talk to',
    description: 'A concept for a mobile, AI-first Photoshop for 2030, built to stay fast on low-compute devices. I was the designer on a six-person team, owning the product vision, the home experience, Orby, and the interaction model.',
    tags: ['AI-Native', 'Interaction Design', 'Product Design'],
    href: '/work/photoshop-2030',
  },
];

// Second tab alongside the existing case studies — direct instruction:
// "we are adding another tab in work... case studies, and other work."
// Same tabs-wrap/radio/:has() pattern already used on /reading and
// /writings for exactly this "two different content shapes under one
// heading" situation (a short curated list next to a longer scrollable
// grid) — not a new pattern, reused wholesale.
//
// title/caption/tags below are my own read of the actual uploaded files
// (public/images/work/other-work/<slug>/), not invented — direct
// instruction: "figure out the title tags and caption by yourself."
// `type` drives the on-click viewer: 'gallery' pages through `items` as
// images (covers both plain image sets and the ARKA deck — a deck is just
// a gallery of slide images, no separate viewer needed), 'reel' plays
// through `items` as vertical video clips instead — direct instruction:
// "decks anda all whatever is the pattern of that specific work. present
// accordingly."
//
// Order is direct instruction (explicit numbered list) — tags avoid the
// word "Graphics" (direct instruction) in favor of naming what the piece
// actually is.
const otherWork = [
  {
    id: 'adobe-inter-iit-reels',
    title: 'Adobe × Inter IIT - Behind the Build',
    caption: 'Story reels from building the Adobe problem statement at Inter IIT Tech Meet 14.0.',
    tags: ['Product', 'Process'],
    type: 'reel',
    folder: 'adobe-inter-iit-reels',
    count: 9,
    ext: 'mp4',
    cover: 'adobe-inter-iit-reels/cover.jpg',
    // Live video cover instead of a static frame — first of the Other
    // Work grid covers to go this way (direct instruction: "changing the
    // other work's covers non static... make slide 3 the cover"). Grid
    // still needs `cover` above as the poster (shown before the clip
    // buffers in, and as the alt-less fallback if video ever fails).
    coverVideo: 'adobe-inter-iit-reels/03.mp4',
  },
  {
    id: 'arka-techpark',
    title: 'ARKA - IIT Jodhpur Technology Park',
    caption: 'A full brand identity for IIT Jodhpur’s proposed technology park - logo system, signage, and architecture, presented as a real pitch deck.',
    tags: ['Branding', 'Pitch Deck'],
    type: 'gallery',
    folder: 'arka-techpark',
    count: 9,
    ext: 'jpg',
  },
  {
    id: 'guru-dhanji',
    title: 'Guru Dhanji',
    caption: 'A vintage banknote-and-postage-stamp pastiche portrait.',
    tags: ['Poster', 'Concept'],
    type: 'gallery',
    folder: 'guru-dhanji',
    count: 5,
    ext: 'jpg',
    coverCycle: true,
  },
  {
    id: 'kurt-cobain',
    title: 'Kurt Cobain',
    caption: 'A tribute poster built entirely from Kurt Cobain’s own handwriting, quote, and signature.',
    tags: ['Poster', 'Typography'],
    type: 'gallery',
    folder: 'kurt-cobain',
    count: 5,
    ext: 'jpg',
  },
  {
    id: 'boat-packaging',
    title: 'boAt Rockerz 255 Pro+',
    caption: 'Packaging design concept for boAt’s wireless neckband earphones - “Plug into Nirvana.”',
    tags: ['Packaging', 'Product Design'],
    type: 'gallery',
    folder: 'boat-packaging',
    count: 5,
    ext: 'jpg',
    // Cover cycles through every slide in this piece on a fast,
    // uncrossfaded cut — no transition between frames, just a hard swap
    // (see the coverCycle script further down) — direct instruction:
    // "quickly changing animation... match cuts type, not literally that
    // but that speed."
    coverCycle: true,
  },
  {
    id: 'perfect-days-poster',
    title: 'Perfect Days',
    caption: 'An editorial poster series for Wim Wenders’s Perfect Days.',
    tags: ['Poster', 'Editorial'],
    type: 'gallery',
    folder: 'perfect-days-poster',
    count: 5,
    ext: 'jpg',
  },
  {
    id: 'se7en-poster',
    title: 'Se7en',
    caption: 'A seven-deadly-sins poster for David Fincher’s Se7en.',
    tags: ['Poster', 'Editorial'],
    type: 'gallery',
    folder: 'se7en-poster',
    count: 3,
    ext: 'jpg',
  },
  {
    id: 'big-dawgs-hanumankind',
    title: 'Big Dawgs - Hanumankind',
    caption: 'A grunge, halftone poster series for Hanumankind’s “Big Dawgs.”',
    tags: ['Poster', 'Album Art'],
    type: 'gallery',
    folder: 'big-dawgs-hanumankind',
    count: 5,
    ext: 'jpg',
    coverCycle: true,
  },
  {
    id: 'vedavriksha',
    title: 'Veda Vriksha',
    caption: 'Brand identity and packaging for an Ayurvedic anti-hairfall haircare label - logo, bottle label, and out-of-home signage.',
    tags: ['Branding', 'Packaging'],
    type: 'gallery',
    folder: 'vedavriksha',
    count: 8,
    ext: 'jpg',
    coverCycle: true,
  },
];

// Expands folder/count/ext into a real items[] list + resolves cover —
// keeps the array above short/hand-writable instead of listing every
// filename per piece.
const otherWorkResolved = otherWork.map((w) => ({
  ...w,
  cover: w.cover ?? `${w.folder}/01.${w.ext === 'mp4' ? 'jpg' : w.ext}`,
  items: Array.from({ length: w.count }, (_, i) => `${w.folder}/${String(i + 1).padStart(2, '0')}.${w.ext}`),
}));
---

<AppLayout
  title="Work · Ishan Rajpurohit"
  description="Selected product, brand and interaction design projects by Ishan Rajpurohit, including CSite, Reimagining Photoshop 2030, and a curated grid of other design work."
>
  <Window title="Work" height={738} transitionName="active-window">
    <div class="w-page">
      <div class="tabs-wrap">
        <input type="radio" name="work-tab" id="tab-case-studies" class="tab-radio" checked />
        <input type="radio" name="work-tab" id="tab-other-work" class="tab-radio" />

        <div class="tab-panel panel-case-studies">
          <div class="panel-header">
            <div class="panel-heading">
              <h1>Selected Case Studies</h1>
              <p>Product and interaction design across startups and national-level events.</p>
            </div>
            <div class="tab-switcher">
              <label for="tab-case-studies" class="tab-pill">Case Studies</label>
              <label for="tab-other-work" class="tab-pill">Other Work</label>
            </div>
          </div>
          <div class="cs-grid">
            {
              caseStudies.map((c) => (
                <a class="cs-item" href={c.href}>
                  <span class="cs-item-cover">
                    {c.video ? (
                      <video src={c.video} poster={c.image} autoplay muted loop playsinline preload="auto" />
                    ) : (
                      <img src={c.image} alt={c.title} style={c.imageStyle} />
                    )}
                  </span>
                  <span class="cs-item-title">{c.title}</span>
                  <span class="cs-item-desc">{c.description}</span>
                  <span class="cs-item-tags">
                    {c.tags.map((t) => (
                      <span class="ow-tag">{t}</span>
                    ))}
                  </span>
                </a>
              ))
            }
          </div>
        </div>

        <div class="tab-panel panel-other-work">
          <div class="panel-header">
            <div class="panel-heading">
              <h1>Everything else.</h1>
              <p>Branding, packaging, and posters - the design work outside the case studies.</p>
            </div>
            <div class="tab-switcher">
              <label for="tab-case-studies" class="tab-pill">Case Studies</label>
              <label for="tab-other-work" class="tab-pill">Other Work</label>
            </div>
          </div>
          <div class="other-work-grid">
            {
              otherWorkResolved.map((w, i) => (
                <button
                  type="button"
                  class="ow-item"
                  data-ow-index={i}
                  aria-haspopup="dialog"
                  aria-label={`${w.title} - view`}
                >
                  <span class="ow-item-cover">
                    {w.coverVideo ? (
                      <video
                        src={`/images/work/other-work/${w.coverVideo}`}
                        poster={`/images/work/other-work/${w.cover}`}
                        autoplay
                        muted
                        loop
                        playsinline
                        preload="auto"
                      />
                    ) : (
                      <img
                        src={`/images/work/other-work/${w.cover}`}
                        alt={w.title}
                        loading="lazy"
                        data-cycle={w.coverCycle ? 'true' : undefined}
                      />
                    )}
                    {w.type === 'reel' && !w.coverVideo && (
                      <span class="ow-play-badge" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="white">
                          <path d="M8 5.5v13l11-6.5-11-6.5z" />
                        </svg>
                      </span>
                    )}
                  </span>
                  <span class="ow-item-caption">{w.caption}</span>
                  <span class="ow-item-tags">
                    {w.tags.map((t) => (
                      <span class="ow-tag">{t}</span>
                    ))}
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </Window>

  <Fragment slot="mobile">
    <MobileTitlebar title="Work" />
    <div class="m-work">
      <input type="radio" name="m-work-tab" id="m-tab-case-studies" class="m-tab-radio" checked />
      <input type="radio" name="m-work-tab" id="m-tab-other-work" class="m-tab-radio" />

      <div class="m-work-switcher">
        <label for="m-tab-case-studies" class="m-tab-pill">Case Studies</label>
        <label for="m-tab-other-work" class="m-tab-pill">Other Work</label>
      </div>

      <div class="m-tab-panel m-panel-case-studies">
        <header class="m-work-heading">
          <h1>Selected Case Studies</h1>
          <p>Product and interaction design across startups and national-level events.</p>
        </header>
        <div class="m-cs-list">
          {
            caseStudies.map((c) => (
              <a class="m-cs-item" href={c.href}>
                <span class="m-cs-item-cover">
                  {c.video ? (
                    <video src={c.video} poster={c.image} autoplay muted loop playsinline preload="auto" />
                  ) : (
                    <img src={c.image} alt={c.title} style={c.imageStyle} />
                  )}
                </span>
                <span class="m-cs-item-title">{c.title}</span>
                <span class="m-cs-item-desc">{c.description}</span>
                <span class="m-cs-item-tags">
                  {c.tags.map((t) => (
                    <span class="ow-tag">{t}</span>
                  ))}
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <div class="m-tab-panel m-panel-other-work">
        <header class="m-work-heading">
          <h1>Everything else.</h1>
          <p>Branding, packaging, and posters - the design work outside the case studies.</p>
        </header>
        <div class="m-other-work-grid">
          {
            otherWorkResolved.map((w, i) => (
              <button
                type="button"
                class="m-ow-item"
                data-ow-index={i}
                aria-haspopup="dialog"
                aria-label={`${w.title} - view`}
              >
                <span class="m-ow-item-cover">
                  {w.coverVideo ? (
                    <video
                      src={`/images/work/other-work/${w.coverVideo}`}
                      poster={`/images/work/other-work/${w.cover}`}
                      autoplay
                      muted
                      loop
                      playsinline
                      preload="auto"
                    />
                  ) : (
                    <img
                      src={`/images/work/other-work/${w.cover}`}
                      alt={w.title}
                      loading="lazy"
                      data-cycle={w.coverCycle ? 'true' : undefined}
                    />
                  )}
                  {w.type === 'reel' && !w.coverVideo && (
                    <span class="ow-play-badge" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="white">
                        <path d="M8 5.5v13l11-6.5-11-6.5z" />
                      </svg>
                    </span>
                  )}
                </span>
                <span class="m-ow-item-caption">{w.caption}</span>
                <span class="m-ow-item-tags">
                  {w.tags.map((t) => (
                    <span class="ow-tag">{t}</span>
                  ))}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </Fragment>
</AppLayout>

<!-- Other-Work item viewer — a cinematic filmstrip, not a small dialog box:
     the active slide sits large and sharp in the center with the previous/
     next slide receding, hazy, and partly hidden behind it on either side
     (direct instruction: "build something like this with bigger displays,
     bigger overlays" + reference screenshot of a filmstrip/timeline
     viewer). Tapping a neighbor pages to it. A tick-mark scrubber below —
     one tick per slide, the active one tall and dark — replaces the old
     plain "1 / 9" counter and doubles as a jump-to-slide control. Same
     escape-.scale-frame reasoning as every other overlay this site already
     has (music.astro's .album-overlay, reading.astro's .film-overlay):
     AppLayout hardcodes scaleMode="fit-both", so left inside that subtree
     this would inherit the ambient scale-down and center against the
     shrunk frame instead of the real viewport. -->
<div class="ow-overlay" id="ow-overlay" role="dialog" aria-modal="true" aria-hidden="true" aria-label="Work item viewer">
  <button type="button" class="ow-overlay-close" id="ow-overlay-close" aria-label="Close">&times;</button>
  <div class="ow-stage" id="ow-stage">
    <button type="button" class="ow-neighbor ow-neighbor-prev" id="ow-overlay-prev" aria-label="Previous"></button>
    <div class="ow-hero-wrap">
      <div class="ow-overlay-frame" id="ow-overlay-frame"></div>
    </div>
    <button type="button" class="ow-neighbor ow-neighbor-next" id="ow-overlay-next" aria-label="Next"></button>
  </div>
  <div class="ow-overlay-meta">
    <p class="ow-overlay-title" id="ow-overlay-title"></p>
    <p class="ow-overlay-caption" id="ow-overlay-caption"></p>
    <div class="ow-overlay-tags" id="ow-overlay-tags"></div>
  </div>
  <div class="ow-scrub" id="ow-scrub" role="slider" aria-label="Slide position"></div>
  <div class="ow-counter-row">
    <button type="button" class="ow-chevron ow-chevron-prev" id="ow-chevron-prev" aria-label="Previous slide">
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
        <path d="M12.5 5L7.5 10L12.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
    <p class="ow-overlay-counter" id="ow-overlay-counter"></p>
    <button type="button" class="ow-chevron ow-chevron-next" id="ow-chevron-next" aria-label="Next slide">
      <svg width="14" height="14" viewBox="0 0 20 20" fill="none">
        <path d="M7.5 5L12.5 10L7.5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>
</div>

<script define:vars={{ otherWork: otherWorkResolved }}>
  (function () {
    // Everything DOM-related here is `let`, not `const`, and queried fresh
    // inside bindOtherWorkOverlay() (bottom of this IIFE) instead of once
    // up top — confirmed live: Astro skips re-executing an inline script
    // whose content is byte-identical to one it already ran (otherWork
    // never changes, so define:vars serializes the same script text every
    // time), even though the DOM around it — including a genuinely fresh
    // #ow-overlay node — gets rebuilt normally on each navigation. Symptom:
    // grid covers stop opening the filmstrip after as little as one
    // revisit to /work, no console error, because the click listeners from
    // the very first run only ever pointed at that first run's elements.
    // Same root shape as the music-overlay bug fixed earlier this session,
    // different trigger — same fix shape too: bindOtherWorkOverlay() runs
    // once here AND on every astro:page-load, which stays correct because
    // that listener is bound to `document` (never replaced), independent
    // of whether this script tag's own top-level code ever runs again.
    let overlay, frame, counterEl, titleEl, captionEl, tagsEl, closeBtn, prevBtn, nextBtn, chevronPrevBtn, chevronNextBtn, scrubEl;

    let activePiece = null;
    let activeIndex = 0;
    let lastTrigger = null;

    // Inline sizing (not scoped CSS): elements created via document.createElement
    // never receive Astro's data-astro-cid-* scoping attribute, so a scoped
    // selector targeting them in <style> would silently fail to match.
    const HERO_BASE = 'display:block; height:100%; max-width:100%; width:auto; object-fit:contain; border-radius:20px;';
    const NEIGHBOR_STYLE = 'display:block; width:100%; height:100%; object-fit:cover; animation: ow-neighbor-in 0.55s ease-out;';

    // Direction-aware entrance: on prev/next the incoming hero starts from
    // roughly the neighbor's own look (scaled down, hazy, blurred, offset
    // to the side it's coming from) and animates up into the sharp,
    // full-size, centered hero — reads as that side card physically
    // stepping forward to become the new center, not just a plain fade
    // (direct instruction: "that inactive card behind should feel like
    // coming forward"). Plain centered fade/scale on first open, where
    // there's no "side" for it to come from.
    function heroStyle(direction) {
      const anim =
        direction === 'next'
          ? 'ow-hero-in-next 0.7s cubic-bezier(0.16, 1, 0.3, 1)'
          : direction === 'prev'
            ? 'ow-hero-in-prev 0.7s cubic-bezier(0.16, 1, 0.3, 1)'
            : 'ow-hero-in 0.5s cubic-bezier(0.22, 1, 0.36, 1)';
      return `${HERO_BASE} animation: ${anim};`;
    }

    function buildMedia(piece, idx, hero, direction) {
      const src = `/images/work/other-work/${piece.items[idx]}`;
      const style = hero ? heroStyle(direction) : NEIGHBOR_STYLE;
      if (piece.type === 'reel') {
        const video = document.createElement('video');
        video.src = src;
        video.muted = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.style.cssText = style;
        if (hero) {
          video.autoplay = true;
          video.loop = true;
        } else {
          // Neighbor clips never play — just force the first frame to
          // paint instead of sitting on a black rectangle.
          video.addEventListener('loadedmetadata', () => {
            video.currentTime = 0.1;
          });
        }
        return video;
      }
      const img = document.createElement('img');
      img.src = src;
      img.alt = `${piece.title} - ${idx + 1} of ${piece.items.length}`;
      img.loading = hero ? 'eager' : 'lazy';
      img.style.cssText = style;
      return img;
    }

    function updateScrub() {
      Array.from(scrubEl.children).forEach((tick, i) => {
        tick.classList.toggle('is-active', i === activeIndex);
      });
    }

    function buildScrub() {
      scrubEl.innerHTML = '';
      activePiece.items.forEach((_, i) => {
        const tick = document.createElement('button');
        tick.type = 'button';
        tick.className = 'ow-scrub-tick';
        tick.setAttribute('aria-label', `Go to slide ${i + 1}`);
        tick.addEventListener('click', () => go(i));
        scrubEl.appendChild(tick);
      });
      updateScrub();
    }

    function renderStage(direction) {
      if (!activePiece) return;
      const n = activePiece.items.length;
      const prevIdx = (activeIndex - 1 + n) % n;
      const nextIdx = (activeIndex + 1) % n;

      frame.innerHTML = '';
      frame.appendChild(buildMedia(activePiece, activeIndex, true, direction));

      prevBtn.innerHTML = '';
      prevBtn.appendChild(buildMedia(activePiece, prevIdx, false));

      nextBtn.innerHTML = '';
      nextBtn.appendChild(buildMedia(activePiece, nextIdx, false));

      counterEl.textContent = `${activeIndex + 1} / ${n}`;
      updateScrub();
    }

    function go(newIndex, direction) {
      if (!activePiece) return;
      const n = activePiece.items.length;
      const resolvedDirection = direction || (((newIndex % n) + n) % n > activeIndex ? 'next' : 'prev');
      activeIndex = ((newIndex % n) + n) % n;
      renderStage(resolvedDirection);
    }

    function openPiece(index, trigger) {
      const piece = otherWork[index];
      if (!piece) return;
      activePiece = piece;
      activeIndex = 0;
      lastTrigger = trigger || null;

      titleEl.textContent = piece.title;
      captionEl.textContent = piece.caption;
      tagsEl.innerHTML = '';
      piece.tags.forEach((t) => {
        const span = document.createElement('span');
        span.className = 'ow-tag';
        span.textContent = t;
        tagsEl.appendChild(span);
      });

      buildScrub();
      renderStage();
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      closeBtn.focus();
    }

    function closePiece() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      frame.innerHTML = '';
      prevBtn.innerHTML = '';
      nextBtn.innerHTML = '';
      activePiece = null;
      if (lastTrigger instanceof HTMLElement) lastTrigger.focus();
      lastTrigger = null;
    }

    // Bound once on `document` (stable across navigations, unlike anything
    // inside #ow-overlay) — reads the current overlay/prevBtn/nextBtn live
    // via closure, so it stays correct regardless of which #ow-overlay
    // copy is actually on screen.
    document.addEventListener('keydown', (e) => {
      if (!overlay?.classList.contains('is-open')) return;
      if (e.key === 'Escape') closePiece();
      if (e.key === 'ArrowLeft') prevBtn?.click();
      if (e.key === 'ArrowRight') nextBtn?.click();
    });

    function bindOtherWorkOverlay() {
      overlay = document.getElementById('ow-overlay');
      if (!overlay) return;

      // Escape .scale-frame's transform — see the markup comment above.
      document.body.appendChild(overlay);

      frame = document.getElementById('ow-overlay-frame');
      counterEl = document.getElementById('ow-overlay-counter');
      titleEl = document.getElementById('ow-overlay-title');
      captionEl = document.getElementById('ow-overlay-caption');
      tagsEl = document.getElementById('ow-overlay-tags');
      closeBtn = document.getElementById('ow-overlay-close');
      prevBtn = document.getElementById('ow-overlay-prev');
      nextBtn = document.getElementById('ow-overlay-next');
      chevronPrevBtn = document.getElementById('ow-chevron-prev');
      chevronNextBtn = document.getElementById('ow-chevron-next');
      scrubEl = document.getElementById('ow-scrub');

      document.querySelectorAll('[data-ow-index]').forEach((el) => {
        el.addEventListener('click', () => openPiece(Number(el.dataset.owIndex), el));
      });

      prevBtn.addEventListener('click', () => go(activeIndex - 1, 'prev'));
      nextBtn.addEventListener('click', () => go(activeIndex + 1, 'next'));
      chevronPrevBtn.addEventListener('click', () => go(activeIndex - 1, 'prev'));
      chevronNextBtn.addEventListener('click', () => go(activeIndex + 1, 'next'));

      closeBtn.addEventListener('click', closePiece);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closePiece();
      });
    }
    bindOtherWorkOverlay();
    document.addEventListener('astro:page-load', bindOtherWorkOverlay);

    // Deep link into a specific Other Work piece, e.g. /work#adobe-inter-iit-reels
    // (used by Photoshop 2030's "More Visuals" tab to link straight to the
    // Adobe reel instead of just dropping the visitor on /work and making
    // them find it) — switches to the Other Work tab and opens the filmstrip
    // overlay directly on that piece. Runs after bindOtherWorkOverlay() above
    // so overlay/frame/etc are already queried and ready for openPiece().
    function applyDeepLink() {
      const hash = window.location.hash.replace('#', '');
      if (!hash) return;
      const idx = otherWork.findIndex((p) => p.id === hash);
      if (idx === -1) return;
      const radio = document.getElementById('tab-other-work');
      if (radio instanceof HTMLInputElement) radio.checked = true;
      const mobileRadio = document.getElementById('m-tab-other-work');
      if (mobileRadio instanceof HTMLInputElement) mobileRadio.checked = true;
      openPiece(idx);
    }
    applyDeepLink();
    document.addEventListener('astro:page-load', applyDeepLink);
  })();
</script>

<!-- Cover-cycling — grid covers for pieces flagged coverCycle:true hard-cut
     through every slide in that piece on a fast, uncrossfaded loop (no
     transition, just an instant swap) — direct instruction: "quickly
     changing animation... match cuts type, not literally that but that
     speed." boAt is the first (and currently only) piece flagged this
     way, but this reads coverCycle off otherWork generically rather than
     hardcoding boAt, so flagging any other piece the same way is enough
     to give it the same treatment later. Separate script/IIFE from the
     filmstrip overlay above — unrelated concerns, no reason to share
     state.

     Rebinds on every astro:page-load, not just once at the top — same
     script-dedup bug as everywhere else on this site: define:vars renders
     byte-identical script content every time (otherWork never changes), so
     Astro skips re-executing this tag's top-level code on a revisit even
     though the grid's <img> elements are genuinely fresh. Confirmed live:
     after navigating away from /work and back once, cycling never restarted.
     startCycling() calls stopCycling() first so it's safe to call repeatedly
     (covers astro:page-load's own documented double-fire on first load too,
     without ending up with doubled intervals). -->
<script define:vars={{ otherWork: otherWorkResolved }}>
  (function () {
    const CYCLE_MS = 420;
    let timers = [];

    function stopCycling() {
      timers.splice(0).forEach((t) => clearInterval(t));
    }

    function startCycling() {
      stopCycling();
      document.querySelectorAll('[data-ow-index]').forEach((trigger) => {
        const img = trigger.querySelector('img[data-cycle="true"]');
        if (!img) return;
        const piece = otherWork[Number(trigger.dataset.owIndex)];
        if (!piece || !piece.items || piece.items.length < 2) return;

        let frame = 0;
        const timer = setInterval(() => {
          frame = (frame + 1) % piece.items.length;
          img.src = `/images/work/other-work/${piece.items[frame]}`;
        }, CYCLE_MS);
        timers.push(timer);
      });
    }

    startCycling();
    document.addEventListener('astro:page-load', startCycling);
    // Clear timers before a client-side navigation swaps the DOM out from
    // under them — same reasoning as the Home carousel's own
    // astro:before-preparation cleanup elsewhere on this site.
    document.addEventListener('astro:before-preparation', stopCycling);
  })();
</script>

<!-- Other Work's cover videos (Adobe's coverVideo, e.g.) start inside the
     Other Work tab panel, which is display:none until that tab is selected
     — Case Studies is the default. A <video autoplay> whose load was
     attempted while hidden can get stuck in a failed resource-selection
     state (networkState NETWORK_NO_SOURCE) that .play() alone never
     recovers from; confirmed live via the browser's own console, same root
     cause as Writings' Captures tab and the Photoshop 2030 case study,
     which have their own copies of this exact fix. load() restarts
     resource selection; only called when actually stuck, never on an
     already-playing video. -->
<script>
  function playOtherWorkVideos() {
    document.querySelectorAll('.other-work-grid video, .m-other-work-grid video').forEach((video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      if (video.error || video.networkState === HTMLMediaElement.NETWORK_NO_SOURCE) {
        video.load();
      }
      if (video.paused) video.play().catch(() => {});
    });
  }
  playOtherWorkVideos();
  document.getElementById('tab-other-work')?.addEventListener('change', playOtherWorkVideos);
  document.getElementById('m-tab-other-work')?.addEventListener('change', playOtherWorkVideos);
</script>

