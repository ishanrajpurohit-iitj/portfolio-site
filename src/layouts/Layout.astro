---
import { ClientRouter } from 'astro:transitions';
import '../styles/tokens.css';
import '../styles/global.css';
import MobileDock from '../components/MobileDock.astro';

interface Props {
  title: string;
  description?: string;
  /**
   * 'fit-width'  — scale the 1440px composition down to the viewport width only;
   *                natural height is preserved so the page still scrolls vertically (Home).
   * 'fit-both'   — scale to fit both viewport width and height so nothing scrolls
   *                at the page level (the fixed-size "desktop" app screens).
   */
  scaleMode?: 'fit-width' | 'fit-both';
  /** Full-viewport blurred desktop backdrop, independent of the scaled frame (inner app pages). */
  backdrop?: boolean;
}

const {
  title,
  description = 'Ishan Rajpurohit - Product Designer taking ideas from 0 to 1, crafting thoughtful products and visual experiences.',
  scaleMode = 'fit-width',
  backdrop = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif&family=JetBrains+Mono:wght@100&family=Geist+Mono:wght@400&display=swap" rel="stylesheet">

  <ClientRouter />

  <!-- Holds --frame-scale as an actual stylesheet rule instead of an inline
       style on <html>. transition:persist keeps this literal <style> node
       (and whatever JS has written into its textContent) across every
       client-side navigation, because Astro's router unconditionally wipes
       <html>'s own attributes — including any inline style — on every swap
       (swapRootAttributes in astro/dist/transitions/swap-functions.js) and
       never restores them, since the freshly-fetched document's own <html>
       tag never had that inline style to begin with. A previous version of
       this set --frame-scale directly on <html> and used a MutationObserver
       to reactively reapply it the instant that wipe was detected — timing
       analysis says that should be safe (Astro fires astro:after-swap,
       which re-runs fitScale(), synchronously right after the wipe, and the
       View Transition API suppresses rendering for the whole update
       callback either way) but the actual reported symptom (window stuck to
       the top and clipped, dock thrown to a wrong position, after a
       dock-link navigation — an unscaled 1440x1024 canvas being clipped by
       the viewport — until a full reload) kept recurring on a real device
       regardless. Persisting the node this way needs no race to win at
       all: nothing ever removes it, so there's nothing to reapply. -->
  <style id="frame-scale-style" is:inline transition:name="frame-scale-style" transition:persist>:root{--frame-scale:1}</style>

</head>
<body>
  {backdrop && (
    <div id="page-backdrop" class="page-backdrop" transition:name="page-backdrop" transition:persist>
      <img src="/images/shared/desktop-backdrop.jpg" alt="" />
    </div>
  )}
  <main id="page">
    <div class="scale-viewport" data-scale-mode={scaleMode}>
      <div class="scale-frame">
        <slot />
      </div>
    </div>
    <script is:inline define:vars={{ scaleMode }}>
      // Blocking and inline (not the deferred module script below) so this
      // runs at parse time, before the browser's first paint — .scale-frame
      // reads its transform from --frame-scale (see its CSS rule), which
      // isn't set yet on the very first load of the whole app, so without
      // this the first frame can briefly paint the full unscaled 1440×1024
      // canvas: on a normal viewport that only shows its top-left corner,
      // the window (vertically centered on the full canvas) reading as cut
      // off from above until the deferred script below catches up. Once
      // --frame-scale has been set here (or by that deferred script), it
      // lives on <html> and survives every later client-side navigation
      // automatically — this only ever needs to run once. fit-both's
      // natural height is always exactly 1024 (.app-frame/.intro-stage are
      // hardcoded to that), so it can be scaled here without waiting on
      // layout the way the fit-width case (Home, variable content height)
      // still has to.
      (function () {
        if (window.innerWidth <= 1024 || scaleMode !== 'fit-both') return;
        var scale = Math.min(window.innerWidth / 1440, window.innerHeight / 1024, 1);
        var styleEl = document.getElementById('frame-scale-style');
        if (styleEl) styleEl.textContent = ':root{--frame-scale:' + scale + '}';
      })();
    </script>
    <div class="mobile-shell">
      <div class="mobile-content">
        <slot name="mobile" />
      </div>
      <MobileDock />
    </div>
  </main>

  <!-- Maximize's true-fullscreen target: a window being maximized (see
       Window.astro's flipResize/initWindowControls) gets physically moved
       here via appendChild, escaping .scale-frame's transform:scale(...)
       entirely. That's not optional cosmetic choice — position:fixed's
       containing block is normally the viewport, but the CSS spec makes ANY
       transformed ancestor become the containing block for fixed descendants
       instead, so a maximized window trying to go position:fixed;inset:0
       while still nested inside .scale-frame would size itself against the
       already-scaled 1440x1024 frame, not the real browser viewport — which
       is exactly the bug this fixes: the window filling all the vertical
       space fit-both's height-constrained scaling leaves available, but
       never actually reaching the real edges of the screen horizontally
       (or vice versa, depending on which dimension fit-both's Math.min ends
       up constrained by). Moved back to its original DOM position on
       un-maximize. -->
  <div id="maximize-portal"></div>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox-image" src="" alt="" />
    <video class="lightbox-video" muted loop playsinline></video>
  </div>


  <!-- Persistent global "now playing" widget. Lives out here (not inside
       .scale-frame) for the exact reason #maximize-portal above does:
       position:fixed's containing block is normally the real viewport, but
       ANY transformed ancestor becomes the containing block for fixed
       descendants instead, and .scale-frame has `transform: scale(...)` —
       nested inside it, position:fixed would resolve against the scaled
       1440x1024 frame, not the real screen. It needs the REAL screen edge
       here (not the frame's edge): the frame is centered with visible
       backdrop on either side on any monitor wider than 1440 scaled px, so
       clipping at the frame's own boundary (an earlier version of this) put
       the widget floating in that empty margin — visually anchored to
       nothing, which is what actually read as "not on the edge of screen."

       Playback engine: a real SoundCloud track, controlled through
       SoundCloud's own official Widget JS API (SC.Widget) rather than a
       self-hosted audio file — direct instruction, after the earlier
       placeholder-file approach: "you can use the soundcloud api ... player
       can control the calls instead. some kind of wrapper." Every control
       in this file (play/pause, seek, volume) calls methods on the
       SC.Widget instance wrapping the actual player iframe (see the script
       at the bottom of this file) instead of touching an <audio> element
       directly. No API key needed for this — the Widget API controls a
       track that's already embedded by URL, which is different from
       SoundCloud's HTTP/search API (that one needs a registered client_id,
       and new registrations are effectively closed).

       The iframe itself is NOT rendered here as template markup anymore —
       it's created once in JS and appended to document.documentElement (a
       sibling of <body>, not a descendant), specifically to keep it outside
       Astro's swapBodyElement. Confirmed live: even with transition:persist
       correctly keeping the exact same DOM node across a navigation (the
       node's identity survived), the iframe's own 'load' event still fired
       again during the swap — the "replace body wholesale, then reinsert
       persisted nodes into the new body" sequence detaches everything
       inside the old body from the document for a moment, and browsers
       reset an iframe's browsing context on disconnection regardless of
       whether the exact same node gets reconnected right after (unlike
       <audio>/<video>, which the browser specially preserves across this).
       That reset silently restarted the SoundCloud player's internal state
       every time — reported back as "when i click on mac the song stops".
       Living outside <body> entirely sidesteps the swap altogether: nothing
       in <html>'s other children (this iframe included) is ever touched by
       a body-only swap, so there's nothing left to detach. See
       initSoundCloudWidget's own iframe-creation code further down for the
       actual element (same src/style/allow attributes as this used to
       have). -->
  <script src="https://w.soundcloud.com/player/api.js" is:inline></script>

  <div class="music-widget" id="music-widget" transition:name="music-widget" transition:persist>
    <div class="music-widget-slide">
      <!-- Two separate buttons, not one — direct instruction: the icon
           itself should toggle play/pause, while the rest of the widget
           (the album art) opens the full overlay. A <button> can't nest
           another <button>, hence .music-widget-trigger is a plain div now
           (still carries the pill background via ::before) wrapping two
           sibling buttons instead of one button wrapping two spans. -->
      <div class="music-widget-trigger" id="music-widget-trigger">
        <button type="button" class="music-widget-art-btn" id="music-widget-art-btn" aria-label="Now playing: Good Days by SZA, open player">
          <span class="music-widget-art">
            <img src="/images/music/good-days-cover.png" alt="" draggable="false" id="music-widget-art-img" />
          </span>
        </button>
        <button type="button" class="music-widget-icon-btn" id="music-widget-icon-btn" data-icon="chevron" aria-label="Play or pause">
          <svg class="icon-chevron" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5-11-6.5z"/></svg>
          <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="music-overlay" id="music-overlay" aria-hidden="true">
    <div class="music-overlay-card">
      <div class="music-overlay-art">
        <img src="/images/music/good-days-cover.png" alt="" id="music-overlay-art-img" />
      </div>
      <div class="music-overlay-meta">
        <p class="music-overlay-title" id="music-overlay-title">Good Days</p>
        <p class="music-overlay-artist" id="music-overlay-artist">SZA</p>
      </div>

      <!-- Timeline/seek bar — direct instruction ("the large overlay main
           player should have more [controls]"), scoped to THIS overlay
           only, not the small widget. Track is clickable/draggable to seek;
           the fill width and both time labels are driven live off the real
           SoundCloud track's position, via SC.Widget's own PLAY_PROGRESS
           event and a one-time getDuration() call on READY (see
           initSoundCloudWidget in the script below) — not an <audio>
           element's timeupdate/loadedmetadata, now that playback is a real
           embedded SoundCloud track rather than a self-hosted file. -->
      <div class="music-overlay-timeline">
        <div class="music-overlay-timeline-track" id="music-overlay-timeline-track">
          <div class="music-overlay-timeline-fill" id="music-overlay-timeline-fill"></div>
          <div class="music-overlay-timeline-thumb" id="music-overlay-timeline-thumb"></div>
        </div>
        <div class="music-overlay-timeline-times">
          <span id="music-overlay-time-current">0:00</span>
          <span id="music-overlay-time-duration">0:00</span>
        </div>
      </div>

      <!-- Everything that used to be two rows (a centered prev/play/next
           row, then a full-width volume bar below it) is now one row —
           direct instruction: volume was "taking up too much space" as its
           own bar, so it's folded in alongside transport instead, plus a
           new queue button flanking the other side. -->
      <div class="music-overlay-controls">
        <button type="button" class="music-overlay-queue" id="music-overlay-queue" aria-label="Queue" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h13M4 12h13M4 18h9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /><circle cx="19" cy="15" r="2.2" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
        </button>

        <div class="music-overlay-transport">
          <button type="button" class="music-overlay-btn music-overlay-prev" id="music-overlay-prev" aria-label="Previous">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6z"/><path d="M18 6.5v11l-9-5.5 9-5.5z"/></svg>
          </button>
          <button type="button" class="music-overlay-btn music-overlay-play" id="music-overlay-play" aria-label="Play or pause">
            <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor"><path d="M9 6.5v11l9-5.5-9-5.5z"/></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor"><rect x="7" y="6" width="4" height="12" rx="1.2"/><rect x="14" y="6" width="4" height="12" rx="1.2"/></svg>
          </button>
          <button type="button" class="music-overlay-btn music-overlay-next" id="music-overlay-next" aria-label="Next">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16 6h2v12h-2z"/><path d="M6 6.5v11l9-5.5-9-5.5z"/></svg>
          </button>
        </div>

        <!-- Icon-only now, not an icon+always-visible-bar — direct
             instruction: hovering reveals the slider in a popover above the
             icon (pure-CSS :hover, no JS needed to show/hide it), while
             clicking the icon itself still mutes/unmutes directly, same as
             before. Two separate gestures, two separate actions. -->
        <div class="music-overlay-volume-control" id="music-overlay-volume-control">
          <!-- .music-overlay-volume-popover's own box now touches the icon
               directly (bottom:100%, no gap) and its padding-bottom bridges
               what used to be dead space between the two — reported back as
               "slider disappears the moment I try to move the cursor up
               into it", i.e. the gap wasn't covered by ANY element's
               hitbox, so :hover dropped mid-transit before the cursor ever
               reached the popover. The pretty card + its own slide-in
               animation moved to the inner div instead, so the outer
               hit-box stays geometrically constant (touching, not
               animating) while only the visual layer moves. -->
          <div class="music-overlay-volume-popover">
            <div class="music-overlay-volume-popover-inner">
              <input type="range" class="music-overlay-volume-slider" id="music-overlay-volume-slider" min="0" max="1" step="0.01" value="1" aria-label="Volume" />
            </div>
          </div>
          <button type="button" class="music-overlay-mute" id="music-overlay-mute" aria-label="Mute or unmute">
            <svg class="icon-vol-on" viewBox="0 0 24 24" fill="currentColor"><path d="M4 9v6h4l5 5V4L8 9H4z"/><path d="M16.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
            <svg class="icon-vol-off" viewBox="0 0 24 24" fill="currentColor"><path d="M4 9v6h4l5 5V4L8 9H4z"/><path d="M16 9l5 6M21 9l-5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>
          </button>
        </div>
      </div>

      <!-- Queue panel — toggled by the button above. Real track list now
           (see TRACKS in the script below): items are rendered from that
           array by renderQueue(), not hardcoded here, so the heading is the
           only static child — clicking a non-current item loads that track
           (see the click delegation on this panel further down). -->
      <div class="music-overlay-queue-panel" id="music-overlay-queue-panel">
        <p class="music-overlay-queue-heading">Tracklist</p>
      </div>
    </div>
  </div>

  <style>
    /* Figma reference: node 2410:10745 ("music player"). Two layers, and
       deliberately NOT one animating box:

       #music-widget is the STABLE hit-area — position:fixed, right:0 (the
       real screen edge), a fixed vertical position, fixed 108x66 size,
       overflow:hidden, and it NEVER moves or resizes on hover. Reproducing
       Figma's "collapsed sliver / expanded full pill" by moving THIS box
       (an earlier version did: right:-74px -> right:0 on :hover) causes a
       real hover-oscillation bug, confirmed live: sliding the hit-area out
       from under a stationary cursor can put the cursor outside the box's
       new bounds, firing mouseleave, which snaps it back under the cursor,
       firing mouseenter again — a rapid loop that reads as the widget
       "vibrating." A hit-area that never moves can't produce that loop by
       construction, regardless of where the cursor happens to be within it.

       .music-widget-slide is what actually animates — translateX(74px) at
       rest (pushes the pill mostly past the STABLE box's own right edge,
       which IS the screen edge, so overflow:hidden on the parent clips it
       down to the same ~34px sliver Figma's Variant5 shows) to
       translateX(0) on hover (slides fully into view). Figma's two hover
       reference frames also happened to sit 51px lower than the resting
       frame (y:143 -> y:194) — reproduced in an earlier version as a `top`
       animation alongside the horizontal one, and explicitly reported back
       as wrong ("it goes slightly down wtf") rather than reading as
       Figma's intended motion — dropped; hover is horizontal-only now. */
    .music-widget {
      position: fixed;
      top: calc(50% - 247px);
      right: 0;
      width: 108px;
      height: 66px;
      overflow: hidden;
      z-index: 500;
    }

    .music-widget-slide {
      position: relative;
      width: 100%;
      height: 100%;
      transform: translateX(74px);
      transition: transform 0.3s ease-out;
    }

    .music-widget.is-expanded .music-widget-slide {
      transform: translateX(0);
    }

    .music-widget-trigger {
      position: relative;
      width: 100%;
      height: 100%;
      /* The album-art <img> inside is natively draggable by every browser
         (the built-in "drag this image out" ghost-drag feature) — a real
         click with even a pixel or two of incidental movement can get
         hijacked into that native drag instead of registering as a click,
         which is exactly what "can only be dragged, not clicked" turned out
         to be. -webkit-user-drag covers the image itself (draggable="false"
         on the <img> tag handles the rest, incl. non-WebKit); user-select
         stops the click-drag from also selecting the "Good Days by SZA"
         label text as a side effect. */
      -webkit-user-drag: none;
      user-select: none;
    }

    .music-widget.is-dragging .music-widget-art-btn,
    .music-widget.is-dragging .music-widget-icon-btn {
      cursor: grabbing;
    }

    .music-widget-trigger::before {
      content: '';
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.49);
      border-radius: 60px 0 0 60px;
    }

    /* The album-art button — opens the full overlay (see
       #music-widget-art-btn's click handler). Separate from
       #music-widget-icon-btn now: direct instruction was for the icon
       specifically to toggle play/pause instead of also opening the
       overlay, which the single shared button this replaced couldn't do
       (one click target, one action). */
    .music-widget-art-btn {
      position: absolute;
      left: 6px;
      top: 6px;
      width: 55px;
      height: 54px;
      padding: 0;
      border: none;
      background: none;
      cursor: grab;
      -webkit-tap-highlight-color: transparent;
    }

    .music-widget-art {
      display: block;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      overflow: hidden;
    }

    .music-widget-art img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      animation: music-vinyl-spin 8s linear infinite;
    }

    /* Vinyl-style spin, applied to the art image only (not its circular
       mask), so the disc rotates while the "window" it's viewed through
       stays put. First pass used a real LP's literal 33 1/3 RPM (1.8s/
       revolution) — reported back as "too fast" for a ~55-100px circle, so
       this is a slower, purely decorative rate instead of the literal
       figure. Runs continuously regardless of actual playback state
       (explicit direction: "keep it rotating all the time"), not gated to
       audio being unpaused. */
    @keyframes music-vinyl-spin {
      from {
        transform: rotate(0deg);
      }
      to {
        transform: rotate(360deg);
      }
    }

    /* The play/pause/chevron button — toggles playback directly (see
       #music-widget-icon-btn's click handler), separate from the art button
       above which opens the overlay instead. */
    /* Hit area (32x32) is deliberately bigger than the visual glyph (22x22,
       centered inside via the svg rule below) — 22px alone is a genuinely
       small real-world click target on a widget this small, and "not
       functional" may partly have been "hard to land the exact pixel"
       rather than a pure logic bug. right:11px (not 16px) keeps the glyph's
       CENTER at the same visual spot the original 22px box had. */
    .music-widget-icon-btn {
      position: absolute;
      right: 11px;
      top: 50%;
      transform: translateY(-50%);
      width: 32px;
      height: 32px;
      padding: 0;
      border: none;
      background: none;
      cursor: pointer;
      color: #f5f0e6;
      -webkit-tap-highlight-color: transparent;
    }

    .music-widget-icon-btn svg {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 22px;
      height: 22px;
      transform: translate(-50%, -50%);
      opacity: 0;
      transition: opacity 0.2s ease-out;
    }

    .music-widget-icon-btn[data-icon='chevron'] .icon-chevron,
    .music-widget-icon-btn[data-icon='play'] .icon-play,
    .music-widget-icon-btn[data-icon='pause'] .icon-pause {
      opacity: 1;
    }

    /* Was desktop-only ("for now" per an earlier direct instruction) —
       direct instruction lifted that: "add music player to mobile version
       as well now". Same breakpoint as .scale-viewport/.mobile-shell's own
       swap, but the widget/overlay themselves stay visible; only their
       hover-dependent bits get touch-friendly overrides below, since touch
       has no :hover/:focus-within at all. */
    /* Mobile trades desktop's pill-widget (hover-sliver + separate
       play/pause icon button) for just the rotating album-cover circle —
       direct instruction: "just a rotating album cover orb instead of the
       small overlay like desktop." Still hides to an edge sliver like
       desktop's own collapsed state (direct follow-up: "hide it in edge
       like we did for desktop") — touch has no hover to reveal it though,
       so revealing is now a tap (see the click handler below) instead:
       first tap while collapsed expands the orb into view, a second tap
       opens the player. No icon-btn regardless of expanded state — a
       single tap target, not two. */
    @media (max-width: 1024px) {
      /* Desktop's own 74px collapsed offset (see the base .music-widget-slide
         rule) was tuned for its 108px-wide pill; this orb is narrower (64px),
         so a smaller offset leaves a proportionally similar sliver (~18px)
         peeking past the true screen edge instead of hiding the whole thing
         or barely tucking any of it away. .is-expanded (below) still
         overrides back to translateX(0) — same class, same mechanism as
         desktop, just now toggled by tap instead of :hover/:focus-within
         (see the click handler's own comment). */
      .music-widget-slide {
        transform: translateX(46px);
      }

      /* No stable-hitbox-vs-sliding-inner split needed the way desktop's
         markup structurally has one (.music-widget outer + .music-widget-
         slide inner) — that split exists purely to dodge a hover-oscillation
         bug (see .music-widget's own comment up top) that doesn't apply to
         touch at all (nothing here reacts to a finger merely being nearby).
         Reusing the same two elements anyway (rather than restructuring the
         shared markup) since the slide element's translateX already does
         exactly what's needed: overflow stays visible (not clipped to a
         mask) so the sliver's drop-shadow (see .music-widget-art below)
         renders naturally on whatever portion is still inside the real
         viewport, rather than being cut off by an arbitrary CSS box. */
      .music-widget {
        width: 64px;
        height: 64px;
        overflow: visible;
        /* Defensively above MobileDock (also z-index:500) rather than
           relying on DOM-order as the tiebreaker for two equal z-index
           values — an implicit tiebreak is exactly the kind of thing a
           later, unrelated markup reorder could silently invert. */
        z-index: 600;
        /* Top-right — direct instruction. right: same env(safe-area-inset)
           pattern MobileDock.astro already uses for its own bottom edge —
           plain 16px would sit the orb under a notch/Dynamic Island on
           phones that have one. top is NOT the equivalent small offset
           though — found live, exactly matching the "disappears in full
           screen window mode" report: MobileTitlebar.astro's own maximized
           state puts a SECOND floating pill (the traffic lights) at that
           identical corner — top: max(10px, safe-area-inset-top); right:
           14px; see its own comment for why top-right specifically — with
           a much lower z-index (20) than this widget's 600. The orb doesn't
           literally disappear; it sits ON TOP of and blocks the maximized
           window's own back/minimize/restore controls, which is worse, not
           better. 76px (safe-area+66px on notched phones) clears that
           cluster's real footprint (10-46px) with margin to spare, on both
           the maximized floating-pill titlebar AND the resting in-flow one
           (which sits even lower, inset within the non-maximized sheet's
           own top margin — never a conflict there to begin with). Still
           "top right" as asked, just low enough not to collide with the
           window's own chrome. Still draggable afterward (see the
           pointerdown handler below) — this is only the initial resting
           spot before any drag/localStorage value takes over. */
        top: max(76px, calc(env(safe-area-inset-top, 0px) + 66px));
        right: max(16px, calc(env(safe-area-inset-right, 0px) + 12px));
      }

